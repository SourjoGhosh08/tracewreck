# SQLite database path used by local development and the container.
# The data directory is created automatically when the app first opens the database.
# Keep the existing filename so local fixtures and persisted volumes remain compatible.
DATABASE_URL=file:./data/agentpostmortem.db
# Destructive demo reset endpoint opt-in. Keep false in production.
ALLOW_DEMO_RESET=false

# Optional server-side diagnosis provider. Leave unset to keep live diagnosis
# unavailable while the app remains functional and the demo report remains
# explicitly labeled.
# Expected convention: LLM_BASE_URL is either the provider's OpenAI-compatible
# API root (for example https://provider.example/v1) or the full
# https://provider.example/v1/chat/completions URL. The adapter appends
# /chat/completions only when the full path is not already present.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Bounded diagnosis request/input limits. Values are server-side only.
LLM_TIMEOUT_MS=12000
LLM_MAX_RESPONSE_BYTES=131072
LLM_MAX_OUTPUT_TOKENS=2500
DIAGNOSIS_MAX_STEPS=200
DIAGNOSIS_MAX_CHARS=240000
DIAGNOSIS_MAX_STRING=2000
